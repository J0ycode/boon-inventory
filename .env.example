# BoonBaby Store Manager — environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# Local values come from `pnpm db:start` / `supabase status`. Never commit real secrets.

# --- Supabase (required) -----------------------------------------------------
# API URL of the Supabase project. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key — safe for the browser; all access is governed by RLS. Local: PUBLISHABLE_KEY from `supabase status`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# Secret (service-role) key — BYPASSES RLS. Server-side only (src/lib/supabase/admin.ts) and Edge Functions.
# Local: SECRET_KEY from `supabase status`. In production, set it only in the server environment.
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# --- Tenancy (see src/lib/tenant/resolve.ts) ------------------------------------
# Host that serves signup / find-your-shop. Tenants live at {slug}.{ROOT_DOMAIN}. Include the port in dev.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# "subdomain" (default) or "path" (fallback: {ROOT_DOMAIN}/t/{slug}/...).
NEXT_PUBLIC_TENANT_MODE=subdomain
# http in dev, https in production (defaults: http for localhost, https otherwise).
NEXT_PUBLIC_SITE_PROTOCOL=http
# Auth cookie domain. Leave EMPTY in dev (host-only cookie per tenant subdomain).
# Production: ".yourdomain.com" so a session works across tenant subdomains.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# --- Monitoring (optional) --------------------------------------------------------
# Server errors are POSTed here as JSON (Slack incoming webhook, Sentry relay, etc.). Server only.
ERROR_WEBHOOK_URL=

# --- Demo (local only) -----------------------------------------------------------
# Shows a demo-account dropdown on the login page. NEVER set this in production.
DEMO_LOGIN=false
